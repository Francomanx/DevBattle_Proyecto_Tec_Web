generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum CompetitionStatus {
  DRAFT
  ACTIVE
  VOTING
  COMPLETED
}

enum CompetitionRole {
  HOST
  MOD
  DEV
}

enum MetricType {
  OBJECTIVE
  SUBJECTIVE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum GroupRole {
  MEMBER
  ADMIN
}

enum NotificationType {
  STATE_CHANGE
  DISQUALIFICATION
  MOD_REMOVAL
  MESSAGE
}

// -------------------------------------------------------------
// Models
// -------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String
  description     String?
  githubUrl       String?
  competitionsWon Int      @default(0)
  createdAt       DateTime @default(now())

  // Relaciones
  competitionParticipants CompetitionParticipant[]
  projects               Project[]
  votes                  Vote[]
  comments               Comment[]
  sentFriendships        Friendship[]             @relation("UserFriendshipsInitiated")
  receivedFriendships    Friendship[]             @relation("UserFriendshipsReceived")
  sentMessages           Message[]                @relation("SentMessages")
  receivedMessages       Message[]                @relation("ReceivedMessages")
  groupMembers           GroupMember[]
  notifications          Notification[]

  @@map("users")
}

model Competition {
  id                 String            @id @default(cuid())
  title              String
  description        String
  rules              String
  fileFormat         String?
  viewCount          Int               @default(0)
  status             CompetitionStatus @default(ACTIVE)
  submissionDeadline DateTime
  votingDeadline     DateTime
  createdAt          DateTime          @default(now())

  // Relaciones
  participants CompetitionParticipant[]
  metrics      Metric[]
  projects     Project[]

  @@map("competitions")
}

model CompetitionParticipant {
  userId        String
  competitionId String
  role          CompetitionRole @default(DEV)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([userId, competitionId])
  @@index([competitionId])
  @@map("competition_participants")
}

model Metric {
  id            String     @id @default(cuid())
  competitionId String
  name          String
  type          MetricType @default(OBJECTIVE)
  maxValue      Int

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  votes       Vote[]

  @@index([competitionId])
  @@map("metrics")
}

model Project {
  id                    String    @id @default(cuid())
  competitionId         String
  authorId              String
  title                 String
  description           String
  fileUrl               String?
  repoUrl               String?
  submissionDate        DateTime  @default(now())
  isDisqualified        Boolean   @default(false)
  disqualificationReason String?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes       Vote[]
  comments    Comment[]

  @@index([competitionId])
  @@index([authorId])
  @@map("projects")
}

model Vote {
  id        String   @id @default(cuid())
  projectId String
  metricId  String
  voterId   String
  score     Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metric  Metric  @relation(fields: [metricId], references: [id], onDelete: Cascade)
  voter   User    @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([projectId, metricId, voterId])
  @@index([voterId])
  @@index([metricId])
  @@map("votes")
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@map("comments")
}

model Friendship {
  user1Id String
  user2Id String
  status  FriendshipStatus @default(PENDING)

  user1 User @relation("UserFriendshipsInitiated", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("UserFriendshipsReceived", fields: [user2Id], references: [id], onDelete: Cascade)

  @@id([user1Id, user2Id])
  @@index([user2Id])
  @@map("friendships")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String?
  groupId    String?
  content    String
  createdAt  DateTime @default(now())

  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User?  @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  group    Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([groupId])
  @@map("messages")
}

model Group {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  members  GroupMember[]
  messages Message[]

  @@map("groups")
}

model GroupMember {
  groupId String
  userId  String
  role    GroupRole @default(MEMBER)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  content   String
  type      NotificationType @default(STATE_CHANGE)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}