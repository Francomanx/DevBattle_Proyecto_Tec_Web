# EJEMPLO DE VARIABLES DE ENTORNO 
# Copia este archivo a .env y reemplaza los valores de ejemplo
#   cp .env.example .env

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER="db_user_example"
POSTGRES_PASSWORD="change_this_with_a_secure_password"
POSTGRES_DB="devbattle_example_db"
POSTGRES_PORT=5432

# --- Prisma / API Database URL ---
# Formato: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://db_user_example:change_this_with_a_secure_password@localhost:5432/devbattle_example_db?schema=public"

# --- Web & API URLs ---
# URL pública de la API tRPC
# NEXT_PUBLIC_API_URL="http://localhost:3001"

# Origen permitido por CORS en el backend (URL del frontend)
WEB_URL="http://localhost:3000"

# Hostnames adicionales permitidos en desarrollo
# ALLOWED_DEV_ORIGINS="localhost,127.0.0.1"
