# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=devbattle
POSTGRES_PASSWORD=devbattle
POSTGRES_DB=devbattle
POSTGRES_PORT=5432

# --- Prisma / API ---
DATABASE_URL="postgresql://devbattle:devbattle@localhost:5432/devbattle?schema=public"

# --- Web -> API ---
# URL pública del backend (tRPC)
# NEXT_PUBLIC_API_URL="http://localhost:3001"
# Origen permitido por CORS en el backend (URL del frontend)
WEB_URL="http://localhost:3000"

# --- NextAuth / Auth.js ---
AUTH_SECRET="devbattle-local-secret-change-before-deploy-32chars"

# --- Resend (password-change verification codes) ---
# Create an API key in Resend and verify the sender domain/address first.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="DevBattle <noreply@your-verified-domain.com>"
